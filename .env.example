# ─────────────────────────────────────────────────────────────
# Camio configuration — copy this file to `.env.local` and edit.
# ─────────────────────────────────────────────────────────────

# Which machine is this running on?
#   mac   -> captures the camera via ffmpeg "avfoundation"  (development)
#   linux -> captures the camera via ffmpeg "v4l2"          (Ubuntu production)
CAMERA_SOURCE=mac

# The camera device.
#   On mac:   an avfoundation index, usually "0" (run the command in
#             docs to list devices). "0" = default FaceTime/USB cam.
#   On linux: a /dev path, usually "/dev/video0".
CAMERA_DEVICE=0

# Capture settings (lower = less CPU/heat/bandwidth, good for 24/7).
CAMERA_RESOLUTION=1280x720
CAMERA_FPS=25

# ── Ports ──────────────────────────────────────────────────────
# The Camio web app.
APP_PORT=3000

# MediaMTX media-server ports (defaults are fine; change only on conflict).
RTSP_PORT=8554         # internal: ffmpeg -> MediaMTX
WEBRTC_PORT=8889       # browser real-time playback (WHEP)
HLS_PORT=8888          # browser fallback playback (HLS)
MEDIAMTX_API_PORT=9997 # MediaMTX control API — bound to 127.0.0.1 only
                       # (the app reads camera online/uptime from it)

# The MediaMTX stream path name.
STREAM_NAME=cam

# ── Multiple cameras (optional) ──────────────────────────────────
# Leave unset for a single camera (uses CAMERA_DEVICE/RESOLUTION/FPS/STREAM_NAME
# above). To run more than one camera, set CAMERAS to a JSON array — any field
# left out of an entry falls back to the defaults above:
#   CAMERAS=[{"id":"front","label":"Front door","device":"0"},{"id":"garage","label":"Garage","device":"1"}]
CAMERAS=

# Lockdown (default true): bind all MediaMTX ports to 127.0.0.1 so the raw
# stream is unreachable off-box — the app proxies it behind login. Remote
# viewers automatically use the guarded HLS path; WebRTC real-time works when
# viewing locally. Set to false ONLY to allow WebRTC real-time over Tailscale
# (then also set WEBRTC_ADDITIONAL_HOSTS to your 100.x.x.x Tailscale IP).
MEDIAMTX_LOCALHOST_ONLY=true
WEBRTC_ADDITIONAL_HOSTS=

# ── Auth ───────────────────────────────────────────────────────
# Single-user (default). Username you log in with.
CAMIO_USER=admin

# Run `npm run auth:setup` to generate the two values below (it hashes your
# password with scrypt and mints a session secret — never store plaintext).
CAMIO_PASSWORD_HASH=
SESSION_SECRET=

# ── Multiple users (optional) ─────────────────────────────────────
# Leave both unset for single-user (CAMIO_USER/CAMIO_PASSWORD_HASH above).
# To add more logins, either:
#   CAMIO_USERS=[{"username":"alice","hash":"scrypt:..."}]   (inline JSON)
# or point at a file (recommended — keep it out of .env.local):
#   CAMIO_USERS_FILE=./users.json
# Build/update that file with:
#   npm run auth:setup -- --user alice --add-to users.json
CAMIO_USERS=
CAMIO_USERS_FILE=

# How long a login stays valid (hours). Default 168 = 7 days.
SESSION_TTL_HOURS=168

# Set to true ONLY if Camio runs behind a trusted reverse proxy that sets
# X-Forwarded-For. Otherwise that header is ignored (it's client-spoofable),
# and login rate-limiting is keyed on the account instead.
TRUSTED_PROXY=false

# Mark the session cookie Secure (HTTPS only). Keep false for plain-http
# Tailscale/LAN access; set true only when serving behind HTTPS / a TLS proxy.
SESSION_COOKIE_SECURE=false
